# 发票账本 · Docker 部署配置示例
# 用法：cp .env.example .env 后按需修改；.env 已被 .gitignore 忽略，不要提交。
# 下面所有值都是占位符，请替换成自己的配置。

# ---------- 部署形态 ----------
# single：单账套（默认，界面不出现账套概念） / saas：多账套
DEPLOY_MODE=single
# 仅 saas 生效：配置后 t1.example.com 直接定位账套 t1（需要泛域名解析与通配符证书）
TENANT_HOST_SUFFIX=

# ---------- 访问端口 ----------
# 应用直连端口；启用 nginx 档案时建议改成 127.0.0.1:18765
APP_PUBLISH=8765
# 启用 nginx 档案（--profile nginx）时的对外端口
NGINX_PUBLISH=80

# ---------- 私有化授权（两项都留空 = 不校验，按本机自用运行）----------
# 授权密钥由供应商提供，形如 INV-XXXX-XXXX-XXXX，请勿提交到代码仓库
LICENSE_KEY=
# 授权校验服务地址，例如 https://saas.example.com
LICENSE_SERVER=
CHECK_INTERVAL_HOURS=24
GRACE_DAYS=14

# ---------- 数据与运行 ----------
# 命名卷（默认）；想直接在宿主机看到文件就改成绝对路径，例如 /srv/invoice-sorting
DATA_VOLUME=invoice-data
TZ=Asia/Shanghai
# 仅本机单人使用且不想登录时才设为 false
AUTH_ENABLED=true
WATCH_INBOX=true

# ---------- 运行日志与故障上报（两项都留空 = 不上传，诊断包只留在 /data/日志/诊断包/）----------
# 运行日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# **私有**日志仓库，形如 owner/repo；留空即关闭上传
LOG_REPO=
# 细粒度 PAT，只需要该仓库的 Contents 读写权限，请勿提交到代码仓库
LOG_TOKEN=
# 仓库内的应用命名空间与实例名（实例名留空时用容器主机名）
LOG_APP=invoice-sorting
LOG_INSTANCE=
LOG_BRANCH=main

# ---------- 构建参数 ----------
# build：容器内构建前端（默认） / prebuilt：使用仓库中已有的 frontend/dist
FRONTEND_SOURCE=build
# false 时不安装截图文字识别依赖，镜像约小 300MB
INSTALL_OCR=true
# 国内网络可换成镜像源，例如 https://mirrors.aliyun.com/pypi/simple
PYPI_INDEX=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
